{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vision-review.json: a Codex vision review of one attempt (advisory, not part of the QC score)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt",
    "unit",
    "frames",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "attempt": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "unit": {
      "type": "string"
    },
    "frames": {
      "type": "integer",
      "minimum": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop",
        "limbs",
        "identity",
        "overall",
        "summary"
      ],
      "properties": {
        "loop": {
          "$ref": "#/$defs/check"
        },
        "limbs": {
          "$ref": "#/$defs/check"
        },
        "identity": {
          "$ref": "#/$defs/check"
        },
        "overall": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "note"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
